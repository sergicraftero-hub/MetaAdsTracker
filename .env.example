# --- Notion ---
# Token de la integración interna (notion.so/my-integrations). NO lo subas al repositorio.
NOTION_TOKEN=
# ID de la base de datos de leads (los 32 caracteres del enlace de la base)
NOTION_LEADS_DB_ID=bb3ba35266e88398bb0f01f40fa122fc
# (Opcional) Bases de datos propias de la app. Si se dejan vacías, la app las crea sola dentro
# de una página de Notion llamada «BUT Calls» compartida con la integración.
NOTION_USERS_DB_ID=
NOTION_LOG_DB_ID=
NOTION_BONUS_DB_ID=
NOTION_ALERTS_DB_ID=
NOTION_WA_DB_ID=
NOTION_LOCKS_DB_ID=
NOTION_AJUSTES_DB_ID=
NOTION_FICHAJES_DB_ID=
NOTION_SOLICITUDES_DB_ID=
NOTION_NOMINAS_DB_ID=

# (Opcional) Base «Seguimiento O2» de contrataciones. Si se deja vacía, la app la busca por su título.
NOTION_SEGUIMIENTO_DB_ID=

# --- WhatsApp compartido (opcional) ---
# Token del canal de whapi.cloud (el número se vincula con el QR en su panel)
WHAPI_TOKEN=

# --- Acceso ---
# Cadena aleatoria larga para firmar las sesiones (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=
# Administrador inicial (siempre puede entrar, aunque no haya base de usuarios)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dirección

# Los comerciales ven sus leads y, si esto es "true", también los que no tienen comercial asignado
COMERCIAL_VE_SIN_ASIGNAR=true
