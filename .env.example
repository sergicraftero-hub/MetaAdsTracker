# --- Notion ---
# Token de la integración interna (notion.so/my-integrations). NO lo subas al repositorio.
NOTION_TOKEN=
# ID de la base de datos de leads (los 32 caracteres del enlace de la base)
NOTION_LEADS_DB_ID=bb3ba35266e88398bb0f01f40fa122fc
# (Opcional) ID de una base de datos de Notion para los usuarios del CRM.
# Créala vacía, compártela con la integración y la app añade las columnas sola.
NOTION_USERS_DB_ID=

# --- Acceso ---
# Cadena aleatoria larga para firmar las sesiones (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=
# Administrador inicial (siempre puede entrar, aunque no haya base de usuarios)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dirección

# Los comerciales ven sus leads y, si esto es "true", también los que no tienen comercial asignado
COMERCIAL_VE_SIN_ASIGNAR=true
